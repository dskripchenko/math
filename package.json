{
  "name": "@dskripchenko/math",
  "version": "0.1.0",
  "description": "TeX math to MathML with zero runtime dependencies: the commonly written subset of LaTeX math — scripts, fractions, roots, Greek and symbols, big operators, functions, stretching fences, accents, letter styles, text, colours, matrices, cases and aligned equations — drawn by the browser’s own MathML",
  "keywords": [
    "math",
    "tex",
    "latex",
    "mathml",
    "formula",
    "equation",
    "katex-alternative",
    "zero-dependency",
    "ssr"
  ],
  "homepage": "https://github.com/dskripchenko/math#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskripchenko/math.git"
  },
  "bugs": {
    "url": "https://github.com/dskripchenko/math/issues"
  },
  "license": "MIT",
  "author": "Denis Skripchenko (https://github.com/dskripchenko)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/stix-two-math": "5.3.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
